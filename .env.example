# ==============================================================================
# RUGBY WHITE (rugy.in) - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables)
# or in your local .env.local file for local development.

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (Required for Live Online Payments)
# ------------------------------------------------------------------------------
# Get your API keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# In Test Mode: Keys start with 'rzp_test_'
# In Live Mode: Keys start with 'rzp_live_'
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
# Endpoint URL: https://rugy.in/api/payment/webhook
# Active Events: order.paid, payment.captured
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# ------------------------------------------------------------------------------
# 2. PERSISTENT DATABASE (Required for Vercel Serverless Deployments)
# ------------------------------------------------------------------------------
# Serverless PostgreSQL connection string (Works with Neon, Supabase, Vercel Postgres)
# e.g.: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# POSTGRES_URL=

# ------------------------------------------------------------------------------
# 3. SECURE ADMIN DASHBOARD
# ------------------------------------------------------------------------------
# Secret master password to access https://rugy.in/admin/orders
ADMIN_PASSWORD=rugby2026admin

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATIONS (Customer Receipts & Owner New-Order Alerts)
# ------------------------------------------------------------------------------
# Store owner email to receive instant alerts for every paid order
ADMIN_NOTIFICATION_EMAIL=faizal.rugby@gmail.com

# Option A: Resend HTTP API (Recommended for Vercel - free tier 3,000 emails/mo)
# Get key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=orders@rugy.in

# Option B: Standard SMTP (Alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rugy.in
